!hotelcast/backups/.gitkeep
hotelcast/logs/*
!hotelcast/logs/.htaccess
!hotelcast/logs/.gitkeep
hotelcast/storage/*
!hotelcast/storage/.htaccess
!hotelcast/storage/.gitkeep
!hotelcast/storage/cache/
hotelcast/storage/cache/*
!hotelcast/storage/cache/.gitkeep
hotelcast/tests/.phpunit.cache/
*.phar
/dist/
.DS_Store
.idea/
.vscode/
signing-key-DO-NOT-COMMIT/
