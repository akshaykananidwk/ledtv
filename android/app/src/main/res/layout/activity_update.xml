<?xml version="1.0" encoding="utf-8"?>
<!-- 2.6.0 "Update required" screen (UpdateActivity): blocks the player until the required app version is installed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg">

    <View
        android:id="@+id/update_brand_bar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="top"
        android:background="@color/brand" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="40dp"
        android:paddingEnd="96dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/update_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/app_name"
                android:textColor="@color/settings_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/update_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/update_required_title"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/update_required_message"
            android:textColor="@color/settings_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/update_versions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/overlay_pill"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="2.5.0  →  2.6.0" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="32dp"
            android:max="100"
            android:progressTint="@color/brand"
            tools:progress="40" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/settings_text"
            android:textSize="20sp"
            tools:text="Downloading… 40%" />

        <TextView
            android:id="@+id/update_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:visibility="gone"
            tools:text="Download failed. Check the internet connection."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/update_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/settings_text_dim"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/update_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/update_retry"
                style="@style/SettingsButton"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="220dp"
                android:text="@string/update_retry" />

            <Button
                android:id="@+id/update_allow"
                style="@style/SettingsButton"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="220dp"
                android:text="@string/update_allow_installs"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
