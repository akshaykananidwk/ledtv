<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HotelCast" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.HotelCast.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.HotelCast.Settings">
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/settings_text_dim</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SettingsField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/edit_tv</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:textColorHint">#FF607D8B</item>
        <item name="android:textSize">22sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">true</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/btn_tv</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
